msgstr[2] "%1$d нових елементів на огляд на %2$s"

#: includes/class-p2s-alerts.php:291
msgid "Heartbeat: PHP2Shell Guard is running"
msgstr "Сигнал: PHP2Shell Guard працює"

#. translators: %s: date and time, or "never"
#: includes/class-p2s-alerts.php:294
#, php-format
msgid "Last full scan: %s"
msgstr "Останнє повне сканування: %s"

#. translators: %d: number
#: includes/class-p2s-alerts.php:296
#, php-format
msgid "Open critical findings: %d"
msgstr "Відкритих критичних знахідок: %d"

#. translators: %d: number
#: includes/class-p2s-alerts.php:298
#, php-format
msgid "Unacknowledged critical events: %d"
msgstr "Непідтверджених критичних подій: %d"

#: includes/class-p2s-alerts.php:300
msgid ""
"If you stop receiving this message, the guard may have been disabled. Check "
"the site."
msgstr ""
"Якщо ви перестали отримувати це повідомлення, можливо, захист вимкнено. "
"Перевірте сайт."

#. translators: 1: user login, 2: user ID
#: includes/class-p2s-monitor.php:44
#, php-format
msgid "Acting user: %1$s (ID %2$d)"
msgstr "Діючий користувач: %1$s (ID %2$d)"

#: includes/class-p2s-monitor.php:46
