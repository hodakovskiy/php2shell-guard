msgstr "(складне значення)"

#: includes/class-p2s-monitor.php:156
msgid "Open registration was switched on"
msgstr "Відкриту реєстрацію ввімкнено"

#. translators: %s: role name
#: includes/class-p2s-monitor.php:163
#, php-format
msgid "Default role for new users was raised to %s"
msgstr "Роль за замовчуванням для нових користувачів підвищено до %s"

#. translators: %s: option name such as siteurl
#: includes/class-p2s-monitor.php:167
#, php-format
msgid "Setting changed: %s"
msgstr "Налаштування змінено: %s"

#. translators: %s: option name
#: includes/class-p2s-monitor.php:174
#, php-format
msgid "Option: %s"
msgstr "Опція: %s"

#. translators: %s: previous value
#: includes/class-p2s-monitor.php:176
#, php-format
msgid "Old value: %s"
msgstr "Старе значення: %s"

#. translators: %s: new value
#: includes/class-p2s-monitor.php:178
#, php-format
msgid "New value: %s"
msgstr "Нове значення: %s"

#: includes/class-p2s-monitor.php:182
msgid ""
"Changing the site URL or admin email is a common way to hijack a site or "
"take over password resets."
msgstr ""
