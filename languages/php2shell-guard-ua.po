msgstr "Потрібна допомога з очищенням? Зверніться до %s"

#: includes/class-p2s-alerts.php:167
msgid "Alert flood: further alerts suppressed for this hour"
msgstr "Лавина сповіщень: подальші сповіщення пригнічено до кінця години"

#. translators: %d: maximum alerts per hour
#: includes/class-p2s-alerts.php:169
#, php-format
msgid ""
"More than %d alerts were raised within an hour. The rest are still recorded "
"on the Live events tab."
msgstr ""
"Протягом години виникло понад %d сповіщень. Решта все одно записана на "
"вкладці «Події в реальному часі»."

#: includes/class-p2s-alerts.php:257
msgid "CRITICAL"
msgstr "КРИТИЧНО"

#: includes/class-p2s-alerts.php:257
msgid "REVIEW"
msgstr "ОГЛЯД"

#: includes/class-p2s-alerts.php:265
msgid "... more on the admin page"
msgstr "... більше на сторінці адміністратора"

#. translators: 1: number of findings, 2: site host name
#: includes/class-p2s-alerts.php:272
#, php-format
msgid "%1$d new critical finding on %2$s"
msgid_plural "%1$d new critical findings on %2$s"
msgstr[0] "%1$d нова критична знахідка на %2$s"
msgstr[1] "%1$d нові критичні знахідки на %2$s"
msgstr[2] "%1$d нових критичних знахідок на %2$s"

