msgstr ""
"Порівняйте їх зі свіжим завантаженням або вашим репозиторієм."

#: includes/class-p2s-scanner.php:505
msgid "Verified plugins match wordpress.org checksums"
msgstr "Перевірені плагіни відповідають контрольним сумам wordpress.org"

#: includes/class-p2s-scanner.php:505
#, php-format
msgid "%d plugin(s) verified."
msgstr "Перевірено %d плагін(ів)."

#: includes/class-p2s-scanner.php:508
